# -----------------------------------------------------------------------------
# NAMENOLOGY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. DO NOT commit actual secrets.
# -----------------------------------------------------------------------------

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/namenology?schema=public

# Session Authentication Secret (Random string >= 32 characters)
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long

# Stripe Billing & Checkout Configuration
# Test mode keys from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
# Webhook secret from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Optional Redis Connection for distributed rate limiting (fallback to PostgreSQL)
# REDIS_URL=redis://localhost:6379
