# =============================================================================
# NAMENOLOGY — .gitignore
# Next.js 14, TypeScript, Prisma, Node.js, Python utilities
# =============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing & Coverage
coverage/
.nyc_output/

# Next.js Build Outputs
.next/
out/
build/
dist/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Production & Local Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Allow committing the template example
!.env.example

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python Cache & Virtual Environments (scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Database Files
*.sqlite
*.sqlite3
*.db
*.db-journal

# Agent & Temporary IDE Storage
.agents/
