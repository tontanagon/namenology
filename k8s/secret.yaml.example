apiVersion: v1
kind: Secret
metadata:
  name: namenology-secret
  labels:
    app: namenology-web
type: Opaque
stringData:
  # Connection string to PostgreSQL (Internal K8s Service or External DB like Neon/Supabase)
  DATABASE_URL: "postgresql://namenology_user:namenology_secure_pass@namenology-postgres:5432/namenology_db?schema=public"

  # Authentication & Admin
  ADMIN_EMAIL: "admin@namenology.com"
  ADMIN_PASSWORD: "ChangeMeToAStrongPassword2026!"
  ADMIN_NAME: "System Administrator"

  # Payment (Stripe)
  STRIPE_SECRET_KEY: "sk_live_..."
  STRIPE_WEBHOOK_SECRET: "whsec_..."
  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: "pk_live_..."

  # Email SMTP (Optional)
  SMTP_HOST: "smtp.example.com"
  SMTP_PORT: "587"
  SMTP_SECURE: "false"
  SMTP_USER: "noreply@yourdomain.com"
  SMTP_PASS: "smtp_secret_password"
  SMTP_FROM: "Namenology <noreply@yourdomain.com>"
