// =============================================================================
// NAMENOLOGY PRISMA SCHEMA
// Database: PostgreSQL 16
// Architecture: Fully configuration-driven, auditable credit ledger,
//               strict multi-type entitlements, multi-tier analysis versioning
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum Language {
  TH
  EN

  @@map("language")
}

enum CreditType {
  FIRST_NAME
  SURNAME
  COMBINED

  @@map("credit_type")
}

enum CreditSourceType {
  FREE
  PURCHASE
  ADMIN_ADJUSTMENT
  REFUND
  EXPIRED

  @@map("credit_source_type")
}

enum ProductType {
  ANALYSIS_PACKAGE
  SERVICE
  SUBSCRIPTION

  @@map("product_type")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("order_status")
}

enum ServiceOrderStatus {
  PENDING_PAYMENT
  PAID
  FORM_SUBMITTED
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("service_order_status")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE

  @@map("subscription_status")
}

enum AnalysisStatus {
  COMPLETED
  FAILED
  PENDING

  @@map("analysis_status")
}

enum MissingFieldPolicy {
  REDISTRIBUTE_WEIGHT
  SKIP

  @@map("missing_field_policy")
}

// -----------------------------------------------------------------------------
// 1. IDENTITY & ACCESS MODELS
// -----------------------------------------------------------------------------

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique @db.VarChar(255)
  passwordHash     String   @map("password_hash")
  name             String   @db.VarChar(255)
  role             Role     @default(USER)
  isActive         Boolean  @default(true) @map("is_active")
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  sessions              Session[]
  creditLedgerEntries   CreditLedger[]
  analyses              Analysis[]
  orders                Order[]
  serviceOrders         ServiceOrder[]     @relation("UserServiceOrders")
  assignedServiceOrders ServiceOrder[]     @relation("AdminAssignedOrders")
  subscriptions         Subscription[]
  adminAuditLogs        AdminAuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 2. ANALYSIS ENGINE & CONFIGURATION MODELS
// -----------------------------------------------------------------------------

model NameComponent {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(50) // e.g. FIRST_NAME, SURNAME, MIDDLE_NAME, NICKNAME
  label       String   @db.VarChar(100)
  description String?  @db.Text
  isRequired  Boolean  @default(false) @map("is_required")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  weight      Decimal  @default(0) @db.Decimal(5, 2) // Weight percentage (sum of enabled must equal 100.00)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isEnabled])
  @@index([sortOrder])
  @@map("name_components")
}

model CharacterScore {
  id        String   @id @default(uuid()) @db.Uuid
  character String   @db.VarChar(10)
  language  Language
  score     Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([character, language])
  @@index([language, isActive])
  @@map("character_scores")
}

model AnalysisConfig {
  id                  String             @id @default(uuid()) @db.Uuid
  version             String             @unique @db.VarChar(20) // e.g., "1.0"
  freeFirstNameLimit  Int                @default(2) @map("free_first_name_limit")
  freeSurnameLimit    Int                @default(2) @map("free_surname_limit")
  freeCombinedLimit   Int                @default(0) @map("free_combined_limit")
  scorePrecision      Int                @default(2) @map("score_precision")
  missingFieldPolicy  MissingFieldPolicy @default(REDISTRIBUTE_WEIGHT) @map("missing_field_policy")
  minInputLength      Int                @default(1) @map("min_input_length")
  maxInputLength      Int                @default(100) @map("max_input_length")
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("analysis_configs")
}

model ScoreInterpretation {
  id             String   @id @default(uuid()) @db.Uuid
  scoreMin       Int      @map("score_min")
  scoreMax       Int      @map("score_max")
  category       String   @db.VarChar(50)
  title          String   @db.VarChar(200)
  description    String   @db.Text
  recommendation String?  @db.Text
  language       String   @default("en") @db.VarChar(5)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scoreMin, scoreMax, language])
  @@index([isActive])
  @@map("score_interpretations")
}

model NumerologyMeaning {
  id                   String   @id @default(uuid()) @db.Uuid
  number               Int      @unique
  rootNumber           Int      @map("root_number")
  groupNumber          Int      @map("group_number")
  title                String   @db.VarChar(200)
  category             String?  @db.VarChar(50)
  meaningsAndSymbols   String?  @map("meanings_and_symbols") @db.Text
  groupCharacteristics String?  @map("group_characteristics") @db.Text
  lifeDescription      String?  @map("life_description") @db.Text
  shadowPolarity       String?  @map("shadow_polarity") @db.Text
  beWaryOf             String?  @map("be_wary_of") @db.Text
  illnesses            String?  @db.Text
  loveAndFamily        String?  @map("love_and_family") @db.Text
  exampleNames         String?  @map("example_names") @db.Text
  language             String   @default("en") @db.VarChar(5)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([number])
  @@index([rootNumber])
  @@index([groupNumber])
  @@map("numerology_meanings")
}


model Analysis {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  analysisType       CreditType     @map("analysis_type") // FIRST_NAME, SURNAME, COMBINED
  inputText          String         @map("input_text") @db.VarChar(200)
  normalizedText     String         @map("normalized_text") @db.VarChar(200)
  rawScore           Decimal        @map("raw_score") @db.Decimal(10, 4)
  finalScore         Decimal        @map("final_score") @db.Decimal(10, 4) // Normalized to 1 - 100
  calculationVersion String         @map("calculation_version") @db.VarChar(20)
  configSnapshot     Json?          @map("config_snapshot")
  status             AnalysisStatus @default(COMPLETED)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  components       AnalysisComponent[]
  characterDetails AnalysisCharacterDetail[]

  @@index([userId, analysisType, createdAt])
  @@index([calculationVersion])
  @@map("analyses")
}

model AnalysisComponent {
  id           String   @id @default(uuid()) @db.Uuid
  analysisId   String   @map("analysis_id") @db.Uuid
  componentKey String   @map("component_key") @db.VarChar(50) // FIRST_NAME, SURNAME, etc.
  inputText    String   @map("input_text") @db.VarChar(200)
  score        Decimal  @db.Decimal(10, 4)
  weightUsed   Decimal  @map("weight_used") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_components")
}

model AnalysisCharacterDetail {
  id           String   @id @default(uuid()) @db.Uuid
  analysisId   String   @map("analysis_id") @db.Uuid
  componentKey String   @map("component_key") @db.VarChar(50)
  character    String   @db.VarChar(10)
  position     Int
  mappedScore  Int      @map("mapped_score")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("analysis_character_details")
}

// -----------------------------------------------------------------------------
// 3. ENTITLEMENT, CREDIT LEDGER & E-COMMERCE MODELS
// -----------------------------------------------------------------------------

model Product {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique @db.VarChar(50) // e.g. FREE_TIER, PKG_1_SET, PKG_2_SETS, PKG_3_SETS, PKG_5_SETS, SRV_BABY_NAMING
  name          String      @db.VarChar(200)
  description   String?     @db.Text
  productType   ProductType @map("product_type")
  price         Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD") @db.VarChar(3)
  stripePriceId String?     @map("stripe_price_id") @db.VarChar(255)
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @default(0) @map("sort_order")
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  entitlements  ProductEntitlement[]
  orders        Order[]
  serviceOrders ServiceOrder[]
  subscriptions Subscription[]

  @@index([productType, isActive])
  @@index([sortOrder])
  @@map("products")
}

model ProductEntitlement {
  id         String     @id @default(uuid()) @db.Uuid
  productId  String     @map("product_id") @db.Uuid
  creditType CreditType @map("credit_type")
  quantity   Int
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, creditType])
  @@index([productId])
  @@map("product_entitlements")
}

model CreditLedger {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  creditType CreditType       @map("credit_type")
  amount     Int              // Positive = grant, Negative = consume
  sourceType CreditSourceType @map("source_type")
  sourceId   String?          @map("source_id") @db.VarChar(255) // Reference to Order ID, Admin ID, etc.
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, creditType, createdAt])
  @@index([sourceType])
  @@map("credit_ledger")
}

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  userId                  String      @map("user_id") @db.Uuid
  productId               String      @map("product_id") @db.Uuid
  stripeCustomerId        String?     @map("stripe_customer_id") @db.VarChar(255)
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?     @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeSubscriptionId    String?     @map("stripe_subscription_id") @db.VarChar(255)
  amount                  Decimal     @db.Decimal(10, 2)
  currency                String      @default("USD") @db.VarChar(3)
  status                  OrderStatus @default(PENDING)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt                  DateTime?   @map("paid_at") @db.Timestamptz(6)

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  serviceOrders ServiceOrder[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model ServiceOrder {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  productId       String             @map("product_id") @db.Uuid
  orderId         String?            @map("order_id") @db.Uuid
  status          ServiceOrderStatus @default(PENDING_PAYMENT)
  formData        Json?              @map("form_data")
  resultData      Json?              @map("result_data")
  notes           String?            @db.Text
  assignedAdminId String?            @map("assigned_admin_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)

  // Relations
  user          User     @relation("UserServiceOrders", fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedAdmin User?    @relation("AdminAssignedOrders", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([productId])
  @@index([assignedAdminId])
  @@map("service_orders")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  productId            String             @map("product_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String             @map("stripe_price_id") @db.VarChar(255)
  status               SubscriptionStatus
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// 4. AUDIT & SECURITY MODELS
// -----------------------------------------------------------------------------

model StripeWebhookEvent {
  id            String    @id @default(uuid()) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(100)
  processed     Boolean   @default(false)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processed])
  @@index([eventType])
  @@map("stripe_webhook_events")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.VarChar(255)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model RateLimitEntry {
  id       String   @id @default(uuid()) @db.Uuid
  key      String   @unique @db.VarChar(255)
  points   Int      @default(0)
  expireAt DateTime @map("expire_at") @db.Timestamptz(6)

  @@index([key, expireAt])
  @@map("rate_limit_entries")
}
